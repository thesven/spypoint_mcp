SPYPOINT_USERNAME=
SPYPOINT_PASSWORD=
# Alternative to username/password: an existing token (cannot auto-refresh).
# SPYPOINT_TOKEN=
# Optional local download location. Relative paths resolve against this file.
SPYPOINT_DOWNLOAD_DIR=downloads
SPYPOINT_STATE_DIR=.spypoint-state
# Only needed when upstream capture timestamps have no timezone.
# SPYPOINT_CAMERA_TIMEZONE=America/Toronto
# SPYPOINT_INCLUDE_SHARED=true
# SPYPOINT_TIMEOUT_SECONDS=30
# SPYPOINT_MAX_IMAGE_BYTES=10000000
# Exact extra image CDN hostnames, comma-separated, only if SPYPOINT changes its CDN.
# SPYPOINT_IMAGE_HOSTS=
# Existing MP4 video downloads only; maximum configurable limit is 500 MB.
# SPYPOINT_MAX_VIDEO_BYTES=100000000
# Required only for loopback HTTP; generate a random token of at least 32 characters.
# SPYPOINT_MCP_HTTP_TOKEN=
